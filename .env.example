TELEGRAM_USER_SESSION_STRING=
TELEGRAM_SOURCES_PATH=telegram_sources.json
TELEGRAM_FETCH_LIMIT_PER_SOURCE=5
TELEGRAM_INITIAL_MESSAGES_PER_SOURCE=3
AUTO_SCAN_ENABLED=false
SCAN_INTERVAL_MINUTES=5
PUBLICATION_INTERVAL_MINUTES=5
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=admin
