EVENT_MATCH_WINDOW_HOURS=72
EVENT_MATCH_MAX_CANDIDATES=300
IMPORTANCE_AUTO_PUBLISH=60
IMPORTANCE_REVIEW_MIN=50
OPENAI_RETRY_COUNT=3
HTTP_RETRY_COUNT=3
LOG_FILE=logs/dot_news.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
RANKING_DRY_RUN=true
TIKTOK_CLIENT_KEY=
